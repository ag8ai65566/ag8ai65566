# 複製成 .env 後修改。全部都有預設值 —— 可以整份留空直接跑，
# 因為模型、解析度、長度、LoRA 在網頁上都能逐次選。
# 這裡設的只是「打開網頁時的預設值」。

# ---- 預設模型 ---------------------------------------------------------------
# 網頁上可以隨時切換。可用的 id 用這個指令列出：
#   python3 scripts/fetch-model.py --list
#
#   wan22-14b-fp8   Wan 2.2 I2V 14B fp8      24GB 顯存   畫質最好、NSFW 生態最完整
#   wan22-14b-q8    Wan 2.2 I2V 14B GGUF Q8  16GB
#   wan22-14b-q4    Wan 2.2 I2V 14B GGUF Q4  12GB
#   wan22-5b        Wan 2.2 TI2V 5B          12GB       輕量、原生 720p
#   hy15-480p       HunyuanVideo 1.5 480p    10GB       最省顯存
#   hy15-720p       HunyuanVideo 1.5 720p    12GB
#   hy15-720p-hq    HunyuanVideo 1.5 fp16    20GB
MODEL=wan22-14b-fp8

# 4 步 Lightning 加速的預設開關（只有 Wan 2.2 14B 有這個 LoRA）。
# 開 = 一支 5 秒片約 1~3 分鐘；關 = 20 步取樣，慢 4~5 倍、動態略好。
LIGHTNING=true

# 留空就用該模型自己的預設值（Wan 14B 是 480p/81 幀、Hunyuan 是 720p/121 幀）
TIER=
LENGTH=

# ---- CivitAI（在網頁的 LoRA 分頁搜尋 / 下載）---------------------------------
# 搜尋不需要 key，下載需要。
# 到 civitai.com → 右上頭像 → Account settings → API Keys 產生一個。
CIVITAI_API_KEY=

# ---- 額外 LoRA ---------------------------------------------------------------
# 平常直接在網頁上勾就好。這裡填的是「每次都自動套用」的。
# 檔案放進 models/loras/，格式「檔名:強度」，逗號分隔。
# Wan 2.2 是雙專家模型，很多 CivitAI 的 LoRA 分 high/low 兩個檔，
# 那種要用 LORAS_HIGH / LORAS_LOW 分開指定。
LORAS=
LORAS_HIGH=
LORAS_LOW=

# ---- 取樣參數（想實驗才動；留空就用各模型的官方預設）------------------------
STEPS=
CFG=
SHIFT=
BOUNDARY=
SAMPLER=
SCHEDULER=
FPS=
# fp8 模型專用：default / fp8_e4m3fn / fp8_e4m3fn_fast（fast 在 40 系以上較快）
WEIGHT_DTYPE=default

# ---- 執行環境 ---------------------------------------------------------------
# ComfyUI 啟動參數。
#
# 顯存不夠「不代表不能跑」—— 這裡的 --lowvram / --novram 就是讓大模型在小顯卡上
# 跑起來的開關，代價是把權重換到系統記憶體，變慢。網頁的模型分頁會照你的實際
# 顯存告訴你該加哪一個。
#   --lowvram   顯存約為建議值的一半時
#   --novram    顯存遠低於建議值時（最慢，但能跑）
#   --use-sage-attention   有裝 sageattention 時再快一點
COMFY_ARGS=

# 預設只綁 127.0.0.1。要從家裡其他裝置連才改 0.0.0.0（注意：沒有密碼保護）
BIND_ADDR=127.0.0.1

# ---- 拖檔模式（--profile watch）---------------------------------------------
# 沒有寫 .txt 說明時用的預設指令
PROMPT_DEFAULT=subtle natural motion, cinematic
# 拖檔模式要用哪個模型；留空就用上面的 MODEL
WATCH_MODEL=
WATCH_INTERVAL=3
