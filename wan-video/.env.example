# 複製成 .env 後修改。全部都有預設值，可以先整份留空跑起來再調。

# ---- 模型 -------------------------------------------------------------------
# fp8  = 24GB VRAM 以上（4090 / 5090 / A6000），品質最好
# gguf = 8~16GB VRAM，配合 GGUF_QUANT 選量化等級
PROFILE=fp8
GGUF_QUANT=Q4_K_M

# 想手動指定檔名時才需要（會覆蓋 PROFILE 的預設）
# MODEL_HIGH=wan2.2_i2v_high_noise_14B_fp8_scaled.safetensors
# MODEL_LOW=wan2.2_i2v_low_noise_14B_fp8_scaled.safetensors
# TEXT_ENCODER=umt5_xxl_fp8_e4m3fn_scaled.safetensors
# VAE=wan_2.1_vae.safetensors
# fp8 專用：default / fp8_e4m3fn / fp8_e4m3fn_fast（fast 在 4090+ 上較快）
# WEIGHT_DTYPE=default

# ---- 速度 vs 品質 -----------------------------------------------------------
# true  = 4 步 Lightning LoRA，一支 5 秒片約 1~3 分鐘（4090）
# false = 20 步原生取樣，慢 4~5 倍，動態與細節略好
LIGHTNING=true
LIGHTNING_STRENGTH=1.0

# 只有 LIGHTNING=false 時才會用到
STEPS=20
BOUNDARY=10
CFG=3.5
SHIFT=8.0
SAMPLER=euler
SCHEDULER=simple

# ---- 輸出預設值（UI 上可以逐次改）-------------------------------------------
TIER=480p        # 480p 或 720p
LENGTH=81        # 幀數，必須是 4n+1；81 幀 @16fps ≈ 5 秒
FPS=16

# ---- 額外 LoRA ---------------------------------------------------------------
# 檔案放進 ./models/loras/，這裡填「檔名:強度」，逗號分隔。
# Wan 2.2 是雙專家模型：LORAS 會同時套用到 high/low noise 兩邊，
# 只想套一邊時用 LORAS_HIGH / LORAS_LOW（多數 CivitAI 的 LoRA 有分兩個檔）。
LORAS=
LORAS_HIGH=
LORAS_LOW=

# ---- 執行環境 ---------------------------------------------------------------
# ComfyUI 啟動參數。VRAM 不夠時加 --lowvram 或 --novram；
# 想用 sage attention 加速加 --use-sage-attention
COMFY_ARGS=

# 預設只綁 127.0.0.1。要從家裡其他裝置連才改 0.0.0.0（注意：沒有密碼保護）
BIND_ADDR=127.0.0.1

# 拖檔模式（--profile watch）沒有寫 .txt 說明時用的預設指令
PROMPT_DEFAULT=subtle natural motion, cinematic
WATCH_INTERVAL=3
